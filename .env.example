# --- Required ---------------------------------------------------------------
# fal.ai (dashboard → Keys): SAM 3 segmentation, Nano Banana 2 images, Veo 3.1 video
FAL_KEY=
# OpenAI: the LLM steps (world bible, labels, actions, outcomes) and moderation
OPENAI_API_KEY=
# Neon Postgres. On Vercel the Neon integration sets these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Blob for images and videos. On Vercel the Blob store sets this.
BLOB_READ_WRITE_TOKEN=

# --- Optional ---------------------------------------------------------------
# Opens /admin/costs?key=...
ADMIN_KEY=
# Model overrides. LLM ids are provider:model (openai:, anthropic:, gateway:)
# LLM_MODEL=openai:gpt-5.5
# LLM_FAST_MODEL=openai:gpt-5.4-mini
# ANTHROPIC_API_KEY=            # only if an LLM model above is anthropic:
# SEGMENT_MODEL=fal-ai/sam-3/image
# IMAGE_MODEL=fal-ai/nano-banana-2/edit
# VIDEO_MODEL=fal-ai/veo3.1/fast/first-last-frame-to-video
# VIDEO_SECONDS=4
# Credits and limits per anonymous player
# START_CREDITS=20
# GENERATIONS_PER_HOUR=12
# UPLOADS_PER_HOUR=4
